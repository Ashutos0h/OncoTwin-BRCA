# Use the same database name, user, password, and port as the root Docker .env.
DATABASE_URL=postgresql+psycopg://oncotwin:replace_with_local_password@127.0.0.1:5432/oncotwin
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_ENV=development
AUTH_ENABLED=false
READER_API_KEY=replace_with_long_random_reader_key
WRITER_API_KEY=replace_with_long_random_writer_key
LOG_LEVEL=INFO
