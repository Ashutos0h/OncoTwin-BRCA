{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oncotwin:contracts:twin-state:0.1.0",
  "title": "TwinState",
  "description": "Provisional reconstructed baseline; see contracts/README.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "twin_id": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "values": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "quality_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "twin_id",
    "state_version",
    "as_of",
    "event_ids",
    "data_version",
    "values",
    "missing_fields",
    "quality_warnings"
  ],
  "additionalProperties": false
}
