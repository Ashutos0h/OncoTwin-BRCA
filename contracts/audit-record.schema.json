{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oncotwin:contracts:audit-record:0.1.0",
  "title": "AuditRecord",
  "description": "Provisional reconstructed baseline; see contracts/README.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "twin_id": {
      "type": "string",
      "minLength": 1
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "enum": [
        "EVENT_ACCEPTED",
        "STATE_REBUILT",
        "PREDICTION_CREATED"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "prediction_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "twin_id",
    "audit_id",
    "recorded_at",
    "action",
    "actor",
    "event_ids",
    "state_version",
    "snapshot_id",
    "prediction_id",
    "model_version",
    "data_version"
  ],
  "additionalProperties": false
}
