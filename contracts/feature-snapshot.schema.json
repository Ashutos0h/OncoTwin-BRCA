{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oncotwin:contracts:feature-snapshot:0.1.0",
  "title": "FeatureSnapshot",
  "description": "Provisional reconstructed baseline; see contracts/README.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "twin_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "feature_set_version": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "twin_id",
    "snapshot_id",
    "state_version",
    "created_at",
    "data_version",
    "feature_set_version",
    "features",
    "missing_fields"
  ],
  "additionalProperties": false
}
